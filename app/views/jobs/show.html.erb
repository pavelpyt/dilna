<% content_for :title, "#{@job.title} — Dílna" %>
<% content_for :breadcrumb do %>
  Zakázka · <span class="font-mono">#<%= @job.number %></span>
<% end %>
<% content_for :page_title, @job.title %>
<% content_for :page_actions do %>
  <% if @running_time_entry.nil? %>
    <%= button_to "Naskočit na zakázku", job_time_entries_path(@job), class: "btn btn-ghost btn-sm" %>
  <% elsif @running_time_entry.job_id == @job.id %>
    <%= button_to "Ukončit docházku", time_entry_path(@running_time_entry), method: :patch, class: "btn btn-ghost btn-sm" %>
  <% end %>
  <%= link_to "Upravit", edit_job_path(@job), class: "btn btn-ghost btn-sm" %>
<% end %>

<div class="mb-5 flex flex-wrap items-center justify-between gap-4">
  <%= render JobStatusFlowComponent.new(job: @job) %>
  <% unless @job.on_main_flow? %>
    <%= render TagComponent.new(label: job_status_label(@job), tone: job_status_tone(@job)) %>
  <% end %>

  <div class="flex flex-wrap gap-2">
    <% @job.allowed_next_statuses.each do |next_status| %>
      <%= button_to t("jobs.statuses.#{next_status}"), job_status_path(@job, status: next_status),
                    method: :patch, class: "btn btn-ghost btn-sm" %>
    <% end %>
  </div>
</div>

<div class="grid gap-4 lg:grid-cols-[1.6fr_1fr]">
  <div class="space-y-4">
    <%= render CardComponent.new(title: "Položky") do %>
      <table class="w-full border-collapse text-[13.5px]">
        <thead>
          <tr>
            <th class="border-b border-line pb-2.5 text-left font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink-soft">Služba / materiál</th>
            <th class="border-b border-line pb-2.5 text-right font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink-soft">Množ.</th>
            <th class="border-b border-line pb-2.5 text-right font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink-soft">Cena</th>
            <th class="border-b border-line pb-2.5 text-right font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink-soft">Celkem</th>
            <th class="border-b border-line pb-2.5"></th>
          </tr>
        </thead>
        <tbody>
          <% @job_items.each do |job_item| %>
            <tr>
              <td class="border-b border-line py-3"><%= job_item.description %></td>
              <td class="border-b border-line py-3 text-right font-mono tabular-nums"><%= number_with_precision(job_item.quantity, strip_insignificant_zeros: true) %> <%= job_item.unit %></td>
              <td class="border-b border-line py-3 text-right font-mono tabular-nums"><%= number_with_precision(job_item.unit_price, precision: 0) %></td>
              <td class="border-b border-line py-3 text-right font-mono tabular-nums"><%= number_with_precision(job_item.total_without_vat, precision: 0) %></td>
              <td class="border-b border-line py-3 text-right">
                <%= button_to "×", job_job_item_path(@job, job_item), method: :delete,
                              class: "px-2 text-ink-soft hover:text-over",
                              form: { data: { turbo_confirm: "Smazat položku?" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @job_items.empty? %>
        <p class="py-6 text-center text-sm text-ink-soft">Zakázka zatím nemá žádné položky.</p>
      <% end %>

      <div class="flex justify-between pt-3.5 font-display text-[17px] font-extrabold">
        <span>Celkem bez DPH</span>
        <span class="font-mono tabular-nums"><%= number_to_currency(@job.total_without_vat) %></span>
      </div>
      <div class="mt-1 flex justify-between text-[13px] text-ink-soft">
        <span>Celkem s DPH</span>
        <span class="font-mono tabular-nums"><%= number_to_currency(@job.total_with_vat) %></span>
      </div>

      <%= form_with model: [ @job, @new_job_item ], class: "mt-5 space-y-3 border-t border-line pt-4" do |form| %>
        <p class="mono-label">Přidat položku</p>

        <div class="grid gap-3 md:grid-cols-2">
          <%= form.select :service_id, service_options_for_select(@available_services),
                          { include_blank: "Z ceníku (nepovinné)" }, class: "field-input" %>
          <%= form.text_field :description, placeholder: "Popis položky", class: "field-input" %>
        </div>

        <div class="grid gap-3 md:grid-cols-4">
          <%= form.number_field :quantity, step: 0.01, value: 1, placeholder: "Množství", class: "field-input" %>
          <%= form.text_field :unit, value: "ks", placeholder: "Jednotka", class: "field-input" %>
          <%= form.number_field :unit_price, step: 0.01, placeholder: "Cena za jednotku", class: "field-input" %>
          <%= form.number_field :vat_rate, value: 21, placeholder: "DPH %", class: "field-input" %>
        </div>

        <%= form.submit "Přidat položku", class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>

    <%= render CardComponent.new(title: "Checklist") do %>
      <% @checklist_items.each do |checklist_item| %>
        <%= button_to job_checklist_item_path(@job, checklist_item), method: :patch,
                      class: "flex w-full items-center gap-3 border-b border-line py-2.5 text-left last:border-b-0" do %>
          <span class="grid size-5 flex-none place-items-center rounded-[5px] border-2 <%= checklist_item.completed? ? "border-paid bg-paid text-white" : "border-line-strong" %>">
            <% if checklist_item.completed? %>
              <%= render IconComponent.new(name: :check, css_class: "size-3", stroke_width: "3") %>
            <% end %>
          </span>
          <span class="text-sm <%= "text-ink-soft line-through" if checklist_item.completed? %>"><%= checklist_item.label %></span>
        <% end %>
      <% end %>

      <% if @checklist_items.empty? %>
        <p class="text-sm text-ink-soft">Zakázka nemá checklist.</p>
      <% end %>

      <div class="mt-4 space-y-3 border-t border-line pt-4">
        <%= form_with model: [ @job, ChecklistItem.new ], class: "flex gap-2" do |form| %>
          <%= form.text_field :label, placeholder: "Další krok…", class: "field-input" %>
          <%= form.submit "Přidat", class: "btn btn-ghost btn-sm flex-none" %>
        <% end %>

        <% if @checklist_templates.any? %>
          <%= form_with url: job_job_checklists_path(@job), class: "flex gap-2" do |form| %>
            <%= form.select :checklist_template_id,
                            @checklist_templates.map { |template| [ template.name, template.id ] },
                            {}, class: "field-input" %>
            <%= form.submit "Ze šablony", class: "btn btn-ghost btn-sm flex-none" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= render CardComponent.new(title: "Fotodokumentace") do %>
      <div class="grid grid-cols-4 gap-2.5">
        <% @job_photos.each do |job_photo| %>
          <div class="relative aspect-square overflow-hidden rounded-md border border-line bg-surface-muted">
            <%= image_tag job_photo.image.variant(resize_to_fill: [ 300, 300 ]), class: "size-full object-cover", alt: job_photo.caption.to_s %>
            <%= button_to "×", job_job_photo_path(@job, job_photo), method: :delete,
                          class: "absolute right-1 top-1 rounded bg-ink/70 px-1.5 text-xs text-white",
                          form: { data: { turbo_confirm: "Smazat fotku?" } } %>
          </div>
        <% end %>

        <% if @job_photos.empty? %>
          <p class="col-span-4 py-4 text-center text-sm text-ink-soft">Zatím žádné fotky.</p>
        <% end %>
      </div>

      <%= form_with model: [ @job, JobPhoto.new ], class: "mt-4 flex flex-wrap items-end gap-3 border-t border-line pt-4" do |form| %>
        <div class="flex-1">
          <%= form.label :image, "Nahrát fotku", class: "field-label" %>
          <%= form.file_field :image, accept: "image/*", class: "field-input" %>
        </div>
        <div class="flex-1">
          <%= form.label :caption, "Popis", class: "field-label" %>
          <%= form.text_field :caption, class: "field-input" %>
        </div>
        <%= form.submit "Nahrát", class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </div>

  <div class="space-y-4">
    <%= render CardComponent.new(title: "Kde a kdo") do %>
      <% if @job.property %>
        <div class="meta-line">
          <span class="meta-item">
            <%= render IconComponent.new(name: :pin, css_class: "size-[15px] stroke-ink-soft") %>
            <b class="text-ink"><%= @job.property.full_address %></b>
          </span>
        </div>
      <% else %>
        <p class="text-sm text-ink-soft">Zakázka nemá přiřazenou adresu.</p>
      <% end %>
    <% end %>

    <%= render CardComponent.new(title: "Faktura") do %>
      <% if @job.invoice %>
        <div class="flex items-center justify-between">
          <span class="text-[13px]">
            <b class="font-mono"><%= @job.invoice.number %></b> ·
            <%= number_to_currency(@job.invoice.total_with_vat) %>
          </span>
          <%= invoice_status_tag(@job.invoice) %>
        </div>
        <p class="mt-1.5 text-[12px] text-ink-soft">Splatnost <%= l(@job.invoice.due_on, format: :default) %>.</p>
        <% if @job.invoice.pdf_url.present? %>
          <%= link_to "Doklad ve Fakturoidu", @job.invoice.pdf_url, target: "_blank", rel: "noopener",
                      class: "mt-2 block break-all font-mono text-[11px] text-petrol underline" %>
        <% end %>
      <% elsif policy(Invoice).create? && @job.can_change_status_to?("invoiced") %>
        <%= button_to "Vystavit fakturu", job_invoice_path(@job), class: "btn btn-primary btn-sm w-full justify-center" %>
      <% else %>
        <p class="text-sm text-ink-soft">Fakturu jde vystavit z dokončené zakázky.</p>
      <% end %>
    <% end %>

    <%= render CardComponent.new(title: "Nabídka a client hub") do %>
      <% if @quote %>
        <div class="mb-3 flex items-center justify-between">
          <span class="text-[13px]">Nabídka za <b><%= number_to_currency(@quote.total_with_vat) %></b></span>
          <%= render TagComponent.new(label: t("quotes.statuses.#{@quote.status}"), tone: quote_status_tone(@quote)) %>
        </div>
        <% if @quote.valid_until %>
          <p class="mb-3 text-[12px] text-ink-soft">Platí do <%= l(@quote.valid_until, format: :default) %>.</p>
        <% end %>
      <% elsif @job.can_change_status_to?("quote_sent") %>
        <%= button_to "Vystavit nabídku", job_quotes_path(@job), class: "btn btn-primary btn-sm mb-3 w-full justify-center" %>
      <% else %>
        <p class="mb-3 text-sm text-ink-soft">Nabídku jde vystavit z naceněné zakázky.</p>
      <% end %>

      <div class="mono-label">Odkaz pro zákazníka</div>
      <%= link_to @client_hub_url, @client_hub_url, target: "_blank", rel: "noopener",
                  class: "mt-1 block break-all font-mono text-[11px] text-petrol underline" %>
    <% end %>

    <%= render CardComponent.new(title: "Termíny") do %>
      <div class="mb-4 space-y-2">
        <% @visits.each do |visit| %>
          <div class="flex items-center gap-2.5 border-b border-line pb-2 last:border-b-0">
            <% if visit.user %>
              <%= render AvatarComponent.new(person: visit.user, size: :small) %>
            <% end %>
            <div class="min-w-0 flex-1">
              <b class="block text-[13px] font-semibold"><%= l(visit.starts_at, format: :short) %>–<%= l(visit.ends_at, format: :hour_and_minute) %></b>
              <span class="text-[12px] text-ink-soft"><%= visit.user&.full_name || "Nepřiřazeno" %></span>
            </div>
            <%= button_to "×", job_visit_path(@job, visit), method: :delete,
                          class: "px-2 text-ink-soft hover:text-over",
                          form: { data: { turbo_confirm: "Zrušit termín?" } } %>
          </div>
        <% end %>

        <% if @visits.empty? %>
          <p class="text-sm text-ink-soft">Zakázka zatím nemá naplánovaný termín.</p>
        <% end %>
      </div>

      <%= form_with model: [ @job, @new_visit ], class: "space-y-3 border-t border-line pt-4" do |form| %>
        <p class="mono-label">Naplánovat termín</p>
        <%= form.collection_select :user_id, @technicians, :id, :full_name, { include_blank: "Nepřiřazeno" }, class: "field-input" %>
        <%= form.datetime_local_field :starts_at, class: "field-input" %>
        <%= form.datetime_local_field :ends_at, class: "field-input" %>
        <%= form.submit "Naplánovat", class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>

    <%= render CardComponent.new(title: "Zákazník") do %>
      <b class="font-display text-[15px]"><%= @job.client.name %></b>
      <div class="meta-line mt-2">
        <% if @job.client.company_registration_number.present? %>
          <span class="meta-item font-mono">IČO <%= @job.client.company_registration_number %></span>
        <% end %>
        <% if @job.client.phone.present? %>
          <span class="meta-item"><%= @job.client.phone %></span>
        <% end %>
      </div>
      <div class="mt-3.5">
        <%= link_to "Profil klienta", @job.client, class: "btn btn-ghost btn-sm" %>
      </div>
    <% end %>

    <% if @job.description.present? %>
      <%= render CardComponent.new(title: "Zadání") do %>
        <p class="whitespace-pre-line text-[13.5px]"><%= @job.description %></p>
      <% end %>
    <% end %>

    <%= render CardComponent.new(title: "Poznámky") do %>
      <%= form_with model: [ @job, @new_note ], class: "mb-4 space-y-2" do |form| %>
        <%= form.text_area :body, rows: 2, placeholder: "Co je potřeba vědět…", class: "field-input" %>
        <%= form.submit "Přidat poznámku", class: "btn btn-ghost btn-sm" %>
      <% end %>

      <% @notes.each do |note| %>
        <div class="border-b border-line py-3 text-[13.5px] last:border-b-0">
          <div class="mb-0.5 flex justify-between">
            <b class="text-[12.5px]"><%= note.user.full_name %></b>
            <span class="font-mono text-[11px] text-ink-soft"><%= l(note.created_at, format: :short) %></span>
          </div>
          <%= simple_format(note.body, class: "whitespace-pre-line") %>
        </div>
      <% end %>

      <% if @notes.empty? %>
        <p class="text-sm text-ink-soft">Zatím žádné poznámky.</p>
      <% end %>
    <% end %>
  </div>
</div>
