<% content_for :title, "Zapomenuté heslo — Dílna" %>

<%= render CardComponent.new do %>
  <h2 class="mb-1 font-display text-lg font-bold">Zapomenuté heslo</h2>
  <p class="mb-5 text-[13px] text-ink-soft">Pošleme ti e-mail s odkazem na nastavení nového hesla.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |form| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-5">
      <%= form.label :email, class: "field-label" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
    </div>

    <%= form.submit "Poslat odkaz", class: "btn btn-primary w-full justify-center" %>
  <% end %>

  <div class="mt-5 border-t border-line pt-4 text-[13px] text-ink-soft">
    <%= render "devise/shared/links" %>
  </div>
<% end %>
