<% if controller_name != "sessions" %>
  <p class="mb-1"><%= link_to "Přihlásit se", new_session_path(resource_name), class: "text-petrol hover:underline" %></p>
<% end %>

<% if controller_name != "registrations" %>
  <p class="mb-1"><%= link_to "Založit firmu", new_registration_path(resource_name), class: "text-petrol hover:underline" %></p>
<% end %>

<% if controller_name != "passwords" && controller_name != "registrations" %>
  <p class="mb-1"><%= link_to "Zapomenuté heslo", new_password_path(resource_name), class: "text-petrol hover:underline" %></p>
<% end %>
