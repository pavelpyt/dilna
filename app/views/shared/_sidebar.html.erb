<aside class="sticky top-0 hidden h-screen flex-col gap-1 bg-ink px-3.5 py-5 text-[#D9D7CD] md:flex">
  <div class="flex items-center gap-2.5 px-2.5 pb-[22px] pt-1.5">
    <div class="grid size-[30px] place-items-center rounded-md bg-live font-display text-lg font-extrabold text-ink shadow-[inset_0_0_0_1px_rgba(0,0,0,.15)]">D</div>
    <div>
      <div class="font-display text-[19px] font-extrabold tracking-[0.02em] text-surface">Dílna</div>
      <div class="-mt-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-soft">
        <%= current_account.name %>
      </div>
    </div>
  </div>

  <%= render NavItemComponent.new(label: "Přehled", path: root_path, icon: :dashboard, active: nav_item_active?(root_path)) %>

  <div class="mt-auto border-t border-[#2E312D] px-2.5 pt-3">
    <div class="flex items-center gap-2.5 pt-3">
      <%= render AvatarComponent.new(user: current_user, size: :large) %>
      <div class="min-w-0">
        <b class="block truncate text-[13px] font-semibold text-surface"><%= current_user.full_name %></b>
        <small class="text-[11px] text-[#7C7E76]"><%= t("users.roles.#{current_user.role}") %></small>
      </div>
    </div>

    <%= button_to destroy_user_session_path, method: :delete,
                  class: "mt-3 flex w-full items-center gap-3 rounded-md px-3 py-2 text-[13px] font-medium text-[#7C7E76] transition hover:bg-[#2A2D29] hover:text-surface" do %>
      <%= render IconComponent.new(name: :logout, css_class: "size-4 flex-none") %>
      Odhlásit se
    <% end %>
  </div>
</aside>
