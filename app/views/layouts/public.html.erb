<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta name="robots" content="noindex, nofollow">
    <%= render "shared/document_head" %>
  </head>

  <body>
    <div class="mx-auto min-h-screen max-w-[560px] px-4 py-8">
      <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
        <div class="bg-petrol px-5 pb-6 pt-5 text-white">
          <div class="flex items-center gap-2 font-display text-[15px] font-extrabold">
            <span class="grid size-[22px] place-items-center rounded bg-live font-display text-[13px] font-extrabold text-ink">D</span>
            <%= current_account.name %>
          </div>
          <h1 class="mt-3.5 font-display text-[17px] font-bold"><%= yield :public_title %></h1>
          <p class="mt-0.5 text-[12.5px] opacity-90"><%= yield :public_subtitle %></p>
        </div>

        <div class="p-4">
          <%= render "shared/flash_messages" %>
          <%= yield %>
        </div>
      </div>

      <p class="mt-4 text-center font-mono text-[10px] uppercase tracking-[0.14em] text-ink-soft">
        Dílna · <%= current_account.name %>
      </p>
    </div>
  </body>
</html>
