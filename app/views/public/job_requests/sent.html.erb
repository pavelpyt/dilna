<% content_for :title, "Poptávka odeslána — #{current_account.name}" %>
<% content_for :public_title, "Poptávka odeslána" %>
<% content_for :public_subtitle, "Děkujeme, máme ji u sebe." %>

<div class="py-6 text-center">
  <span class="mx-auto grid size-12 place-items-center rounded-full bg-paid-pale text-paid">
    <%= render IconComponent.new(name: :check, css_class: "size-6", stroke_width: "2") %>
  </span>
  <p class="mt-4 text-sm text-ink-soft">
    Ozveme se vám na uvedený kontakt, jakmile poptávku projdeme.
  </p>
  <p class="mt-2 text-sm text-ink-soft">
    Spěchá to? Zavolejte na <b class="text-ink"><%= current_account.phone.presence || "číslo uvedené na webu" %></b>.
  </p>
</div>
