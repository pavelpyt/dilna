  <div class="mt-1.5 font-display text-3xl font-extrabold tabular-nums tracking-[-0.02em] <%= value_class %>"><%= @value %></div>
  <div class="mt-0.5 text-[12.5px] text-ink-soft"><%= content %></div>
</div>
