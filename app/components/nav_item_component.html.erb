<%= link_to @path, class: link_class do %>
  <%= render IconComponent.new(name: @icon, css_class: "size-[18px] flex-none") %>
  <span class="flex-1"><%= @label %></span>
  <% if show_badge? %>
    <span class="grid min-w-5 place-items-center rounded-full bg-live px-1.5 font-mono text-[10px] font-bold text-ink"><%= @badge_count %></span>
  <% end %>
<% end %>
